{
  "name": "composer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "node ./dist/server/entry.mjs",
    "gen:openapi": "uv run --project ../.. python scripts/dump_openapi.py > openapi.json",
    "gen:api": "openapi-ts",
    "gen": "npm run gen:openapi && npm run gen:api"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "astro": "^7.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^6.0.3"
  }
}
