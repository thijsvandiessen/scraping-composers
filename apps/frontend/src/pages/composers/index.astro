---
import Base from "../../layouts/Base.astro";
import { listComposers, type ComposerSort } from "../../lib/api";
import type { ComposerPage } from "../../lib/schemas";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const sortParam = Astro.url.searchParams.get("sort");
const sort: ComposerSort =
  sortParam === "concerts" || sortParam === "sitelinks" ? sortParam : "label";
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(rawPage) && rawPage >= 1 ? rawPage : 1;

let data: ComposerPage | null = null;
let error: string | null = null;
try {
  data = await listComposers({ q: q || undefined, page, sort });
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const totalPages = data ? Math.max(1, Math.ceil(data.total / data.limit)) : 1;

function pageUrl(target: number): string {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (sort !== "label") params.set("sort", sort);
  if (target > 1) params.set("page", String(target));
  const query = params.toString();
  return query ? `/composers?${query}` : "/composers";
}
---

<Base title="Composers">
  <h1>Composers</h1>

  <form class="search-form" method="get" action="/composers">
    <input type="search" name="q" value={q} placeholder="Search composers…" aria-label="Search composers" />
    <select name="sort" aria-label="Sort order">
      <option value="label" selected={sort === "label"}>By name</option>
      <option value="concerts" selected={sort === "concerts"}>By concerts</option>
      <option value="sitelinks" selected={sort === "sitelinks"}>By significance</option>
    </select>
    <button type="submit">Search</button>
  </form>

  {error && (
    <div class="error-box">
      <strong>The composer API is unavailable.</strong>
      <p>{error}</p>
    </div>
  )}

  {data && data.items.length === 0 && <p class="empty">No composers found{q && ` for “${q}”`}.</p>}

  {data && data.items.length > 0 && (
    <>
      <ul class="composer-list">
        {data.items.map((composer) => (
          <li>
            <a href={`/composers/${composer.id}`}>{composer.label}</a>
            <span class="concert-count">
              {sort === "sitelinks"
                ? composer.sitelink_count != null
                  ? `${composer.sitelink_count} Wikipedia${composer.sitelink_count === 1 ? " edition" : " editions"}`
                  : ""
                : composer.concert_count > 0
                  ? `${composer.concert_count} concert${composer.concert_count === 1 ? "" : "s"}`
                  : ""}
            </span>
          </li>
        ))}
      </ul>
      <nav class="pagination" aria-label="Pagination">
        {page > 1 && <a href={pageUrl(page - 1)}>← Previous</a>}
        {page < totalPages && <a href={pageUrl(page + 1)}>Next →</a>}
        <span class="spacer" />
        <span class="summary">
          page {page} of {totalPages} — {data.total} composer{data.total === 1 ? "" : "s"}
        </span>
      </nav>
    </>
  )}
</Base>
