---
import Base from "../../layouts/Base.astro";
import { listComposers } from "../../lib/api";
import { activityCounts, composerListUrl, parseComposerListQuery } from "../../lib/composers";
import type { ComposerPage } from "../../lib/schemas";

const query = parseComposerListQuery(Astro.url);
const { q, sort, page } = query;

let data: ComposerPage | null = null;
let error: string | null = null;
try {
  data = await listComposers({ q: q || undefined, page, sort });
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const totalPages = data ? Math.max(1, Math.ceil(data.total / data.limit)) : 1;
---

<Base title="Composers">
  <h1>Composers</h1>

  <form class="search-form" method="get" action="/composers">
    <input type="search" name="q" value={q} placeholder="Search composers…" aria-label="Search composers" />
    <select name="sort" aria-label="Sort order">
      <option value="label" selected={sort === "label"}>By name</option>
      <option value="concerts" selected={sort === "concerts"}>By concerts</option>
      <option value="recordings" selected={sort === "recordings"}>By albums</option>
    </select>
    <button type="submit">Search</button>
  </form>

  {error && (
    <div class="error-box">
      <strong>The composer API is unavailable.</strong>
      <p>{error}</p>
    </div>
  )}

  {data && data.items.length === 0 && <p class="empty">No composers found{q && ` for “${q}”`}.</p>}

  {data && data.items.length > 0 && (
    <>
      <ul class="composer-list">
        {data.items.map((composer) => (
          <li>
            <a href={`/composers/${composer.id}`}>{composer.label}</a>
            <span class="concert-count">{activityCounts(composer.concert_count, composer.recording_count)}</span>
          </li>
        ))}
      </ul>
      <nav class="pagination" aria-label="Pagination">
        {page > 1 && <a href={composerListUrl({ ...query, page: page - 1 })}>← Previous</a>}
        {page < totalPages && <a href={composerListUrl({ ...query, page: page + 1 })}>Next →</a>}
        <span class="spacer" />
        <span class="summary">
          page {page} of {totalPages} — {data.total} composer{data.total === 1 ? "" : "s"}
        </span>
      </nav>
    </>
  )}
</Base>
