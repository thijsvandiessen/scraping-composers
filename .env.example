# ---------------------------------------------------------------------------
# Template for local dev. Copy to .env (gitignored) and fill in the values —
# `make dev` runs `honcho start -e .env`, which loads it into every process.
#
# Only ADMIN_API_KEY and SCRAPER_CONTACT_EMAIL have no built-in default;
# everything else shows its default and can stay commented out.
# ---------------------------------------------------------------------------

# --- Required ---

# Shared secret guarding the admin API. The admin service fails closed (503)
# without it, and the dashboard forwards the same value as the X-Admin-Key
# header — both processes must read the identical value from here.
ADMIN_API_KEY=dev-key

# Contact email advertised in scraper User-Agent headers. No default: fetching
# a scraper raises RuntimeError until this is set.
SCRAPER_CONTACT_EMAIL=you@example.com

# --- Dashboard (Django) ---

# DEBUG is off by default; runserver won't serve Unfold's admin CSS unless on.
DASHBOARD_DEBUG=1
# DASHBOARD_SECRET_KEY=dev-only-insecure-key
# DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
# DASHBOARD_DB_PATH=apps/dashboard/dashboard.sqlite3   # Django's own SQLite

# --- Service URLs (dashboard + frontend HTTP clients) ---

# ADMIN_API_URL=http://localhost:8001
# GOLD_API_URL=http://localhost:8000     # used by BOTH the dashboard and the frontend
# SILVER_API_URL=http://localhost:8003

# --- Databases / storage (composer_config) ---

# DATABASE_URL=sqlite:///composers.db    # bronze/silver working DB
# GOLD_DB_PATH=./gold.db                 # curated gold DB
# BUCKET_PATH=./raw-data                 # raw scrape output
# CRAWL_CONFIGS_PATH=./crawl_configs.json  # dashboard-managed crawl configs
# GOLD_MIN_SITELINKS=                    # promotion filter; unset = no filter
# GOLD_MIN_APPEARANCES=1                 # rule 1: keep people/ensembles with >= N concerts+recordings
# GOLD_MIN_REFERRERS=1                   # rule 3: keep entities with >= N distinct referrers

# --- Logging ---

# Read by the CLI and the admin API (the crawl and extract stages are long and
# unattended, so they narrate themselves at INFO). DEBUG adds a line per crawled
# page, per markdown chunk and per model call. The CLI's -v is a shorthand for
# DEBUG that also turns up crawl4ai and ollama themselves; --log-level overrides
# this per run.
# LOG_LEVEL=INFO
